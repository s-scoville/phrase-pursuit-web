@page "/game"

@using PhrasePursuitWeb.Web.Services
@using PhrasePursuitWeb.Web.Components.Game
@using PhrasePursuitWeb.Core.Managers
@using PhrasePursuitWeb.Core.Enums
@using PhrasePursuitWeb.Core.Models

@inject GameSessionService GameSession
@inject NavigationManager Navigation

<PageTitle>Phrase Pursuit</PageTitle>

@if (gameManager is not null)
{
    <div class="game-page">

        <div class="puzzle-section">
            <PuzzleDisplay 
                Category="@gameManager.CurrentGame.CurrentPuzzle.Category"
                PuzzleText="@puzzleDisplayText" />
        </div>

        <div class="players-section">
            <PlayerPanel 
                PlayerName="@gameManager.CurrentGame.Players[0].Name"
                CurrentWinnings="@gameManager.CurrentGame.Players[0].CurrentWinnings"
                IsActive="gameManager.CurrentGame.CurrentPlayerIndex == 0" />
            <PlayerPanel 
                PlayerName="@gameManager.CurrentGame.Players[1].Name"
                CurrentWinnings="@gameManager.CurrentGame.Players[1].CurrentWinnings"
                IsActive="gameManager.CurrentGame.CurrentPlayerIndex == 1" />
            <PlayerPanel 
                PlayerName="@gameManager.CurrentGame.Players[2].Name"
                CurrentWinnings="@gameManager.CurrentGame.Players[2].CurrentWinnings"
                IsActive="gameManager.CurrentGame.CurrentPlayerIndex == 2" />
        </div>

        @if (gameManager.CurrentGame.IsGameOver)
        {
            <div class="game-over-section">
                <GameOverPanel 
                    ResultMessage="@gameOverResultMessage"
                    OnPlayAgain="HandlePlayAgainAsync"
                    OnGameSetup='() => Navigation.NavigateTo("/setup")'
                    OnMainMenu='() => Navigation.NavigateTo("/")' />
            </div>
        }
        else {
            <div class="interaction-section">

                <div class="input-section">
                    @if (!isSolveMode)
                    {
                        <LetterBoard 
                            GuessedLetters="@gameManager.CurrentGame.GuessedLetters"
                            IsEnabled="true"
                            CurrentPhase="@gameManager.CurrentGame.CurrentPhase"
                            LetterSelected="HandleLetterSelectedAsync" />
                    }
                    else
                    {
                        <SolveBoard OnSubmit="HandleSolveSubmitAsync"
                            OnCancel="() => isSolveMode = false" />
                    }
                </div>

                <div class="side-section">

                    <div class="spinner-section">
                        <SpinnerDisplay 
                            DisplayText="@spinnerDisplayText" />
                    </div>

                    <div class="status-section">
                        <GameStatus 
                            StatusMessage="@statusMessage" />
                    </div>

                </div>

                <div class="controls-section">
                    <GameControls 
                        CanSpin="@(isHumanTurn && waitingForAction)"
                        CanBuyVowel="@(isHumanTurn && waitingForAction &&
                            gameManager.CurrentGame.CurrentPlayer.CurrentWinnings >= 50 &&
                            hasRemainingVowel)"
                        CanSolve="@(isHumanTurn && waitingForAction)"
                        OnSpin="HandleSpinAsync"
                        OnBuyVowel="HandleBuyVowel"
                        OnSolve="() => isSolveMode = true" />
                </div>
        
            </div>

        }

    </div>
}


@code {
    private GameManager? gameManager;
    private string spinnerDisplayText = "---";
    private string statusMessage = string.Empty;
    private string puzzleDisplayText = string.Empty;
    private bool isSolveMode = false;
    private string gameOverResultMessage = string.Empty;

    private bool isHumanTurn =>
    gameManager?.CurrentGame.CurrentPlayer.PlayerType == PlayerType.Player;

    private bool waitingForAction =>
        gameManager?.CurrentGame.CurrentPhase == TurnPhase.WaitingForAction;

    private bool hasRemainingVowel =>
        gameManager?.CurrentGame.GuessedLetters is not null &&
        "AEIOU".Any(vowel =>
            !gameManager.CurrentGame.GuessedLetters.Contains(vowel));

    protected override void OnInitialized()
    {
        if (GameSession.CurrentGame is null)
        {
            Navigation.NavigateTo("/setup");
            return;
        }

        gameManager = GameSession.CurrentGame;
        puzzleDisplayText = gameManager.GetPuzzleDisplay();
    }

    private async Task HandleLetterSelectedAsync(char letter)
    {
        GuessResult result;

        if (gameManager is null)
        {
            return;
        }

        if (gameManager.CurrentGame.CurrentPhase == TurnPhase.WaitingForConsonant)
        {
            result = await gameManager.GuessConsonantAsync(letter);
        }
        else if (gameManager.CurrentGame.CurrentPhase == TurnPhase.WaitingForVowel)
        {
            result = await gameManager.GuessVowelAsync(letter);
        }
        else
        {
            return;
        }

        if (result.WasCorrect)
        {
            string letterText =
                result.Occurrences == 1
                    ? result.GuessedLetter.ToString()
                    : $"{result.GuessedLetter}'s";

            statusMessage =
                $"There {(result.Occurrences == 1 ? "is" : "are")} " +
                $"{result.Occurrences} {letterText}.\n";


            if (result.MoneyEarned > 0)
            {
                statusMessage += $" You earned {result.MoneyEarned:C0}.";
            }

            puzzleDisplayText = gameManager.GetPuzzleDisplay();
        }
        else
        {
            statusMessage =
                $"There are no {result.GuessedLetter}'s.";
        }

        if (result.PuzzleCompleted)
        {
            statusMessage = "You completed the puzzle!";
            gameOverResultMessage =
                $"You completed the puzzle!\nYou won {gameManager.CurrentGame.Players[0].CurrentWinnings:C0}!";
            puzzleDisplayText = gameManager.GetPuzzleDisplay();
            return;
        }

        if (result.TurnEnded)
        {
            await RunAiTurnsAsync();
        }
    }

    private async Task HandleSpinAsync()
    {
        if (gameManager is null)
        {
            return;
        }

        SpinResult spinResult = gameManager.Spin();

        spinnerDisplayText = spinResult.Outcome switch
        {
            SpinOutcome.Money => spinResult.MoneyValue?.ToString("C0") ?? "$0",
            SpinOutcome.Bankrupt => "BANKRUPT",
            SpinOutcome.LoseTurn => "LOSE TURN",
            _ => "---"
        };

        gameManager.ApplySpinResult(spinResult);

        if (spinResult.Outcome == SpinOutcome.Money)
        {
            statusMessage = "Select a consonant.";
        }
        else
        {
            statusMessage = spinResult.Outcome == SpinOutcome.Bankrupt
                ? "You landed on BANKRUPT."
                : "You landed on LOSE TURN.";

            await RunAiTurnsAsync();
        }
    }

    private void HandleBuyVowel()
    {
        if (gameManager is null)
        {
            return;
        }

        gameManager.BuyVowel();

        statusMessage = "Select a vowel.";
    }

    private async Task HandleSolveSubmitAsync(string solution)
    {
        if (gameManager is null)
        {
            return;
        }

        SolveResult result =
            await gameManager.SolvePuzzleAsync(solution);

        isSolveMode = false;

        if (result.WasCorrect)
        {
            statusMessage = "You solved the puzzle!";
            gameOverResultMessage =
                $"You solved the puzzle!\nYou won {gameManager.CurrentGame.Players[0].CurrentWinnings:C0}!";
            puzzleDisplayText = gameManager.GetPuzzleDisplay();
        }
        else
        {
            statusMessage =
                "Incorrect. You lost your winnings and your turn.";

            await RunAiTurnsAsync();
        }
    }

    private async Task RunAiTurnsAsync()
    {
        if (gameManager is null)
        {
            return;
        }

        while (!gameManager.CurrentGame.IsGameOver &&
               gameManager.CurrentGame.CurrentPlayer.PlayerType == PlayerType.Computer)
        {
            Player aiPlayer = gameManager.CurrentGame.CurrentPlayer;

            int actionThinkingTime = gameManager.GetAiThinkingTime();
            int guessThinkingTime = gameManager.GetAiThinkingTime();
            int solveThinkingTime = gameManager.GetAiThinkingTime();

            statusMessage = $"{aiPlayer.Name} is thinking...";
            StateHasChanged();

            await Task.Delay(actionThinkingTime * 1000);

            AiActionResult result =
                await gameManager.RunAiTurnAsync();

            switch (result.Action)
            {
                case AiAction.Spin:
                    statusMessage = $"{aiPlayer.Name} decided to spin.";
                    StateHasChanged();

                    await Task.Delay(750);

                    if (result.SpinResult is not null)
                    {
                        spinnerDisplayText = result.SpinResult.Outcome switch
                        {
                            SpinOutcome.Money =>
                                result.SpinResult.MoneyValue?.ToString("C0") ?? "$0",

                            SpinOutcome.Bankrupt => "BANKRUPT",

                            SpinOutcome.LoseTurn => "LOSE TURN",

                            _ => "---"
                        };

                        statusMessage = result.SpinResult.Outcome switch
                        {
                            SpinOutcome.Money =>
                                $"{aiPlayer.Name} landed on {spinnerDisplayText}.",

                            SpinOutcome.Bankrupt =>
                                $"{aiPlayer.Name} landed on BANKRUPT.",

                            SpinOutcome.LoseTurn =>
                                $"{aiPlayer.Name} landed on LOSE TURN.",

                            _ => $"{aiPlayer.Name} finished spinning."
                        };

                        StateHasChanged();
                        await Task.Delay(1200);
                    }

                    if (result.GuessResult is not null)
                    {
                        GuessResult guessResult = result.GuessResult;

                        statusMessage = $"{aiPlayer.Name} is thinking...";
                        StateHasChanged();

                        await Task.Delay(guessThinkingTime * 1000);

                        statusMessage =
                            $"{aiPlayer.Name} guessed {guessResult.GuessedLetter}.";

                        StateHasChanged();
                        await Task.Delay(1200);

                        if (guessResult.PuzzleCompleted)
                        {
                            gameOverResultMessage =
                                $"{aiPlayer.Name} completed the puzzle!";
                        }

                        puzzleDisplayText = gameManager.GetPuzzleDisplay();
                        StateHasChanged();

                        if (guessResult.WasCorrect)
                        {
                            string letterText =
                                guessResult.Occurrences == 1
                                    ? guessResult.GuessedLetter.ToString()
                                    : $"{guessResult.GuessedLetter}'s";

                            statusMessage =
                                $"There {(guessResult.Occurrences == 1 ? "is" : "are")} " +
                                $"{guessResult.Occurrences} {letterText}.";

                            if (guessResult.MoneyEarned > 0)
                            {
                                statusMessage +=
                                    $" {aiPlayer.Name} earned {guessResult.MoneyEarned:C0}.";
                            }
                        }
                        else
                        {
                            statusMessage =
                                $"There are no {guessResult.GuessedLetter}'s.";
                        }

                        StateHasChanged();
                        await Task.Delay(1000);
                    }

                    break;

                case AiAction.BuyVowel:
                    statusMessage = $"{aiPlayer.Name} decided to buy a vowel.";
                    StateHasChanged();

                    await Task.Delay(1200);

                    if (result.GuessResult is not null)
                    {
                        GuessResult guessResult = result.GuessResult;

                        statusMessage = $"{aiPlayer.Name} is thinking...";
                        StateHasChanged();

                        await Task.Delay(guessThinkingTime * 1000);

                        statusMessage =
                            $"{aiPlayer.Name} guessed {guessResult.GuessedLetter}.";

                        StateHasChanged();
                        await Task.Delay(1200);

                        if (guessResult.PuzzleCompleted)
                        {
                            gameOverResultMessage =
                                $"{aiPlayer.Name} completed the puzzle!";
                        }

                        puzzleDisplayText = gameManager.GetPuzzleDisplay();
                        StateHasChanged();

                        statusMessage = guessResult.WasCorrect
                            ? $"There {(guessResult.Occurrences == 1 ? "is" : "are")} " +
                              $"{guessResult.Occurrences} {guessResult.GuessedLetter}" +
                              $"{(guessResult.Occurrences == 1 ? "." : "'s.")}"
                            : $"There are no {guessResult.GuessedLetter}'s.";

                        StateHasChanged();
                        await Task.Delay(1000);
                    }

                    break;

                case AiAction.SolvePuzzle:
                    statusMessage =
                        $"{aiPlayer.Name} is attempting to solve the puzzle.";

                    StateHasChanged();
                    await Task.Delay(solveThinkingTime * 1000);

                    if (result.SolveResult is not null)
                    {
                        if (result.SolveResult.WasCorrect)
                        {
                            statusMessage = $"{aiPlayer.Name} solved the puzzle!";
                            gameOverResultMessage = $"{aiPlayer.Name} solved the puzzle!";
                            puzzleDisplayText = gameManager.GetPuzzleDisplay();
                        }
                        else
                        {
                            statusMessage = $"{aiPlayer.Name} failed to solve the puzzle.";
                        }

                        StateHasChanged();
                        await Task.Delay(1000);
                    }

                    break;
            }
        }

        if (gameManager.CurrentGame.IsGameOver)
        {
            statusMessage = "Game over!";
        }
        else
        {
            statusMessage = "Your turn. Choose an action.";
            spinnerDisplayText = "---";
        }

        StateHasChanged();
    }

    private async Task HandlePlayAgainAsync()
    {
        if (gameManager is null)
        {
            return;
        }

        await gameManager.StartNewGameAsync(GameSession.PlayerName);

        puzzleDisplayText = gameManager.GetPuzzleDisplay();
        spinnerDisplayText = "---";
        statusMessage = "Your turn. Choose an action.";
        gameOverResultMessage = string.Empty;
        isSolveMode = false;
    }
}