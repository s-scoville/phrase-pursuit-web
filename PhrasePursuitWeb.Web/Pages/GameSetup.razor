@page "/setup"

@using System.Net.Http.Json
@using PhrasePursuitWeb.Core.AI
@using PhrasePursuitWeb.Core.Enums
@using PhrasePursuitWeb.Core.Interfaces
@using PhrasePursuitWeb.Core.Managers
@using PhrasePursuitWeb.Core.Models
@using PhrasePursuitWeb.Web.Services

@inject HttpClient Http
@inject IStorageService StorageService
@inject StatisticsManager StatisticsManager
@inject SpinManager SpinManager
@inject GameSessionService GameSession
@inject NavigationManager Navigation

<PageTitle>Game Setup | Phrase Pursuit</PageTitle>

<div class="setup-page">

    <div class="header">
        <div class="logo-section">
            @* Logo will go here later *@
        </div>

        <h1>Phrase Pursuit</h1>
    </div>

    <main class="setup-section">

        <div class="setup-form">

            <h2>Game Setup</h2>

            <div class="form-field">
                <label for="playerName">Player Name</label>
                <input id="playerName"
                       type="text"
                       @bind="playerName" />
            </div>

            <div class="form-field">
                <label for="difficulty">Difficulty</label>
                <select id="difficulty"
                        @bind="selectedDifficulty">
                    <option value="@AiDifficulty.Easy">Easy</option>
                    <option value="@AiDifficulty.Normal">Normal</option>
                </select>
            </div>

            <button class="start-game-button"
                    @onclick="StartGameAsync">
                Start Game
            </button>

            <button class="main-menu-button"
                    @onclick='() => Navigation.NavigateTo("/")'>
                Main Menu
            </button>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }

        </div>

    </main>

</div>

@code {
    private string playerName = string.Empty;

    private AiDifficulty selectedDifficulty = AiDifficulty.Normal;

    private string? errorMessage;


    private async Task StartGameAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(playerName))
        {
            errorMessage = "Please enter a player name.";
            return;
        }

        try
        {
            List<Puzzle>? puzzles =
                await Http.GetFromJsonAsync<List<Puzzle>>("data/puzzles.json");

            if (puzzles is null || puzzles.Count == 0)
            {
                errorMessage = "No puzzles could be loaded.";
                return;
            }

            await StatisticsManager.LoadStatisticsAsync();

            PuzzleManager puzzleManager =
                new PuzzleManager(puzzles, StorageService);

            AiController aiController =
                new AiController(selectedDifficulty);

            GameManager gameManager =
                new GameManager(
                    puzzleManager,
                    SpinManager,
                    StatisticsManager,
                    aiController);

            await gameManager.StartNewGameAsync(playerName);

            GameSession.CurrentGame = gameManager;
            GameSession.PlayerName = playerName;

            Navigation.NavigateTo("/game");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to start the game: {ex.Message}";
        }
    }
}